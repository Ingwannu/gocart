# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL = '$'

# PostgreSQL
DATABASE_URL="postgresql://wickedshop:wickedshop@localhost:5432/wickedshop?schema=public"
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Initial admin account created or restored by `npm run db:seed`.
# Set real values in .env only — never commit them.
ADMIN_ID="admin_001"
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Set true only after STRIPE_SECRET_KEY is configured.
NEXT_PUBLIC_ENABLE_STRIPE="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"

# Password reset email delivery via Resend.
RESEND_API_KEY=""
PASSWORD_RESET_FROM="Wicked Shop <noreply@example.com>"

# Ed25519 private key (base64 PKCS8 DER) for signing /api/license/validate
# responses. Generate with: npm run license:keygen
LICENSE_SIGNING_PRIVATE_KEY=""

# Digital product storage. STORAGE_BACKEND=local keeps files on disk under
# storage/private/uploads; STORAGE_BACKEND=s3 streams them to any S3-compatible
# bucket (R2, Spaces, MinIO, AWS S3).
STORAGE_BACKEND="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
